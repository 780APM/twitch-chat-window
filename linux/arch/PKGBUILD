pkgname=twitch-chat-window
pkgver=1.3.0
pkgrel=1
pkgdesc='Movable always-on-top Twitch chat window for KDE Plasma'
arch=('x86_64')
url='https://github.com/780APM/twitch-chat-window-packages'
license=('LicenseRef-Proprietary')
depends=('ca-certificates' 'glibc' 'gtk3' 'xorg-xwayland' 'kglobalacceld' 'hicolor-icon-theme' 'icu'
         'krb5' 'libgcc' 'libstdc++' 'openssl' 'tzdata' 'zlib')
options=('!strip' '!debug')
source=('TwitchChatWindow-linux-x64.tar.gz' 'io.github._780APM.TwitchChatWindow.desktop' 'mark.png')

# The build generates checksums for the archive and branding files before running makepkg.
package() {
    install -dm755 "$pkgdir/usr/lib/$pkgname" "$pkgdir/usr/bin"
    cp -r TwitchChatWindow/. "$pkgdir/usr/lib/$pkgname/"
    ln -s "../lib/$pkgname/$pkgname" "$pkgdir/usr/bin/$pkgname"

    install -Dm644 io.github._780APM.TwitchChatWindow.desktop \
        "$pkgdir/usr/share/applications/io.github._780APM.TwitchChatWindow.desktop"
    install -Dm644 mark.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
    install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
    mv "$pkgdir/usr/lib/$pkgname/licenses/"*.txt "$pkgdir/usr/share/licenses/$pkgname/"
    rmdir "$pkgdir/usr/lib/$pkgname/licenses"
    install -Dm644 TwitchChatWindow/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    rm "$pkgdir/usr/lib/$pkgname/README.md"
}
